# --uninstall: remove installed cr command
uninstall_cr() {
  echo ""
  step "Uninstalling 'cr' command…"
  local removed=false
  for p in "/usr/local/bin/cr" "$HOME/.local/bin/cr"; do
    if [[ -e "$p" ]]; then
      if [[ -w "$p" ]]; then
        rm -f "$p" && success "Removed ${BOLD}$p${RESET}" && removed=true
      elif command -v sudo &>/dev/null; then
        sudo rm -f "$p" && success "Removed ${BOLD}$p${RESET}" && removed=true
      fi
    fi
  done
  if [[ "$removed" == false ]]; then
    warn "No installed 'cr' found in common locations. Maybe you're already free."
  fi
  echo ""
  exit 0
}

#  --del : remove binaries in current directory
del_binaries() {
  echo ""
  info "Scanning ${BOLD}$(pwd)${RESET} for compiled binaries…"
  echo ""

  local found=()
  # Match: executable files with no extension (compiled outputs)
  while IFS= read -r -d '' f; do
    found+=("$f")
  done < <(find . -maxdepth 1 -type f ! -name "*.*" -perm /111 -print0 2>/dev/null)

  if [[ ${#found[@]} -eq 0 ]]; then
    warn "No compiled binaries found in current directory."
    echo ""
    exit 0
  fi

  echo -e "  ${BOLD}Found ${#found[@]} binary/binaries:${RESET}"
  for f in "${found[@]}"; do
    local size; size=$(du -sh "$f" 2>/dev/null | cut -f1)
    echo -e "    ${RED}–${RESET} ${BOLD}$(basename "$f")${RESET}  ${DIM}(${size})${RESET}"
  done
  echo ""
  read -rp "$(echo -e "  ${YELLOW}Delete all ${#found[@]} file(s)? [y/N]${RESET} ")" ans
  echo ""
  case "$ans" in
    y|Y|yes|YES)
      for f in "${found[@]}"; do rm -f "$f"; done
      success "Deleted ${BOLD}${#found[@]}${RESET} binary/binaries."
      ;;
    *)
      info "Aborted. Nothing deleted."
      ;;
  esac
  echo ""
  exit 0
}

