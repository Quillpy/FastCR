#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$SCRIPT_DIR/src"

source "$LIB/args.sh"
source "$LIB/lang.sh"
source "$LIB/run.sh"
source "$LIB/utils.sh"

parse_args "$@"

if [[ -n "$OPT_NEW" ]]; then
    cmd_new "$OPT_NEW"
    exit 0
fi

if [[ -n "$OPT_DEL" ]]; then
    cmd_del "$OPT_DEL"
    exit 0
fi

if [[ -n "$OPT_SHOW_STATS" ]]; then
    cmd_show_stats
    exit 0
fi

[[ -z "$FILE" ]] && { echo "usage: cr [flags] <file>"; exit 1; }
[[ ! -f "$FILE" ]] && { echo "error: file not found: $FILE"; exit 1; }

detect_lang "$FILE"
compile_file
[[ $? -ne 0 ]] && exit 1

if [[ -n "$OPT_COPY" ]]; then
    cmd_copy "$FILE"
    exit 0
fi

if [[ -n "$OPT_WATCH" ]]; then
    cmd_watch
else
    run_file
fi
