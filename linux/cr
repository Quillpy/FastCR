#!/usr/bin/env bash

# Disable slow locale processing
export LC_ALL=C
export LANG=C

# Colours
RED='\033[0;31m';  GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BLUE='\033[0;34m';  DIM='\033[2m'
BOLD='\033[1m';    RESET='\033[0m'

# Logging helpers 
info()    { echo -e "${CYAN}❯${RESET} $*"; }
success() { echo -e "${GREEN}✔${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET} $*"; }
error()   { echo -e "\n${RED}✘ ERROR:${RESET} $*\n" >&2; exit 1; }
step()    { echo -e "${BLUE}›${RESET} $*"; }

# Timing helper
_T0=0
_time_start() { _T0=$(date +%s%3N); }
_time_end()   { local t1; t1=$(date +%s%3N); echo $(( t1 - _T0 )); }

# --help
usage() {
  echo -e ""
  echo -e "  ${BOLD}${CYAN}FastCR${RESET}  –  Compile & Run in one command"
  echo -e "  ${DIM}Full guide → https://github.com/Quillpy/FastCR/blob/main/Documentation.md${RESET}"
  echo -e ""
  echo -e "  ${BOLD}Usage${RESET}"
  echo -e "    ${GREEN}cr${RESET} <file> [args…]   compile (if needed) and run"
  echo -e "    ${GREEN}cr${RESET} --del             delete all cr binaries in current dir"
  echo -e "    ${GREEN}cr${RESET} --keep <file>     run but keep the binary afterwards"
  echo -e "    ${GREEN}cr${RESET} --help | -h       show this help"
  echo -e ""
  echo -e "  ${BOLD}Supported languages${RESET}"
  printf "    ${CYAN}%-14s${RESET} %s\n"  \
    ".c"          "gcc            (compiled)"   \
    ".cpp / .cc"  "g++ C++17      (compiled)"   \
    ".java"       "javac + java   (compiled)"   \
    ".rs"         "rustc          (compiled)"   \
    ".go"         "go run         (interpreted)" \
    ".py"         "python3        (interpreted)" \
    ".js"         "node           (interpreted)" \
    ".ts"         "ts-node        (interpreted)" \
    ".sh"         "bash           (interpreted)" \
    ".rb"         "ruby           (interpreted)" \
    ".php"        "php            (interpreted)"
  echo -e ""
  echo -e "  ${BOLD}Flags${RESET}"
  echo -e "    ${GREEN}--keep${RESET}   keep the compiled binary after running (skip delete prompt)"
  echo -e "    ${GREEN}--del${RESET}    delete all executables/binaries in the current directory"
  echo -e ""
  echo -e "  ${BOLD}Examples${RESET}"
  echo -e "    cr main.c"
  echo -e "    cr app.py --verbose"
  echo -e "    cr Main.java arg1 arg2"
  echo -e "    cr --keep server.rs"
  echo -e "    cr --del"
  echo -e ""

  # Best-effort open browser
  if command -v xdg-open &>/dev/null; then
    xdg-open "https://github.com/Quillpy/FastCR/blob/main/Documentation.md" &>/dev/null &
  elif command -v open &>/dev/null; then
    open "https://github.com/Quillpy/FastCR/blob/main/Documentation.md" &>/dev/null &
  fi
  exit 0
}

#  --del : remove binaries in current directory
del_binaries() {
  echo ""
  info "Scanning ${BOLD}$(pwd)${RESET} for compiled binaries…"
  echo ""

  local found=()
  # Match: executable files with no extension (compiled outputs)
  while IFS= read -r -d '' f; do
    found+=("$f")
  done < <(find . -maxdepth 1 -type f ! -name "*.*" -perm /111 -print0 2>/dev/null)

  if [[ ${#found[@]} -eq 0 ]]; then
    warn "No compiled binaries found in current directory."
    echo ""
    exit 0
  fi

  echo -e "  ${BOLD}Found ${#found[@]} binary/binaries:${RESET}"
  for f in "${found[@]}"; do
    local size; size=$(du -sh "$f" 2>/dev/null | cut -f1)
    echo -e "    ${RED}–${RESET} ${BOLD}$(basename "$f")${RESET}  ${DIM}(${size})${RESET}"
  done
  echo ""
  read -rp "$(echo -e "  ${YELLOW}Delete all ${#found[@]} file(s)? [y/N]${RESET} ")" ans
  echo ""
  case "$ans" in
    y|Y|yes|YES)
      for f in "${found[@]}"; do rm -f "$f"; done
      success "Deleted ${BOLD}${#found[@]}${RESET} binary/binaries."
      ;;
    *)
      info "Aborted. Nothing deleted."
      ;;
  esac
  echo ""
  exit 0
}

#  Argument parsing
[[ $# -eq 0 ]] && usage

KEEP_BIN=false

case "$1" in
  -h|--help) usage ;;
  --del)     del_binaries ;;
  --keep)    KEEP_BIN=true; shift ;;
esac

[[ $# -eq 0 ]] && usage

FILE="$1"; shift
EXTRA_ARGS=("$@")

[[ -f "$FILE" ]] || error "File not found: '${BOLD}$FILE${RESET}'"

# Extract file parts
BASENAME="$(basename "$FILE")"
EXT="${BASENAME##*.}"
NAME="${BASENAME%.*}"
DIR="$(cd "$(dirname "$FILE")" && pwd)"
OUTBIN="${DIR}/${NAME}"

# Require a tool 
need() {
  command -v "$1" &>/dev/null || \
    error "'${BOLD}$1${RESET}' is not installed. Please install it and retry."
}

# Header 
echo ""
echo -e "  ${BOLD}${CYAN}FastCR${RESET}  ${DIM}──────────────────────────────${RESET}"
echo -e "  ${DIM}File  :${RESET}  ${BOLD}$FILE${RESET}"
echo -e "  ${DIM}Lang  :${RESET}  ${BOLD}.${EXT}${RESET}"
echo -e "  ${DIM}─────────────────────────────────${RESET}"
echo ""

#  Printing run result
print_run_result() {
  local code="$1" ms="$2"
  echo -e "  ${DIM}─────────────────────────────────${RESET}"
  if [[ "$code" -eq 0 ]]; then
    success "${BOLD}Run successful${RESET}  ${DIM}│  exit code ${BOLD}0${RESET}${DIM}  │  ${ms}ms${RESET}  ✓"
  else
    warn "${BOLD}Run finished with errors${RESET}  ${DIM}│  exit code ${BOLD}${code}${RESET}${DIM}  │  ${ms}ms${RESET}"
  fi
  echo ""
}

#  Ask to delete the binary

maybe_delete() {
  local bin="$1"
  [[ -f "$bin" ]] || return
  if [[ "$KEEP_BIN" == true ]]; then
    info "Binary kept (--keep flag): ${BOLD}${bin}${RESET}"
    echo ""
    return
  fi
  read -rp "$(echo -e "  ${YELLOW}Delete compiled binary '${BOLD}$(basename "$bin")${RESET}${YELLOW}'? [Y/n]${RESET} ")" ans
  echo ""
  case "$ans" in
    n|N|no|NO)
      info "Binary kept: ${BOLD}${bin}${RESET}"
      ;;
    *)
      rm -f "$bin"
      success "Binary deleted."
      ;;
  esac
  echo ""
}

#  Compiled language runner
compiled_run() {
  local compiler="$1"; shift   # remaining args = compile flags (no -o, no FILE)
  need "$compiler"

  step "Compiling with ${BOLD}${compiler}${RESET}…"
  _time_start
  if "$compiler" "$@" -o "$OUTBIN" "$FILE"; then
    local ms; ms=$(_time_end)
    success "${BOLD}Compile successful${RESET}  ${DIM}│  ${ms}ms${RESET}"
  else
    echo ""
    error "Compilation failed. Fix the errors above and retry."
  fi

  echo ""
  step "Running ${BOLD}$(basename "$OUTBIN")${RESET}…"
  echo -e "  ${DIM}─────────────────────────────────${RESET}"
  _time_start
  "$OUTBIN" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
  local code=$?
  local ms; ms=$(_time_end)
  print_run_result "$code" "$ms"
  maybe_delete "$OUTBIN"
  exit "$code"
}

#  Interpreted language runner

interpreted_run() {
  local runtime="$1"; shift    # remaining args = runtime flags before FILE
  need "$runtime"

  step "Running with ${BOLD}${runtime}${RESET}…"
  echo -e "  ${DIM}─────────────────────────────────${RESET}"
  _time_start
  "$runtime" "$@" "$FILE" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
  local code=$?
  local ms; ms=$(_time_end)
  print_run_result "$code" "$ms"
  exit "$code"
}

#  Language dispatch

case "$EXT" in

  c)
    compiled_run gcc -Wall -Wextra -O2
    ;;

  cpp|cc|cxx)
    compiled_run g++ -Wall -Wextra -O2 -std=c++17
    ;;

  java)
    need javac; need java
    step "Compiling with ${BOLD}javac${RESET}…"
    _time_start
    if javac -d "$DIR" "$FILE"; then
      ms=$(_time_end)
      success "${BOLD}Compile successful${RESET}  ${DIM}│  ${ms}ms${RESET}"
    else
      echo ""
      error "Compilation failed. Fix the errors above and retry."
    fi
    echo ""
    step "Running ${BOLD}${NAME}${RESET} with java…"
    echo -e "  ${DIM}─────────────────────────────────${RESET}"
    _time_start
    java -cp "$DIR" "$NAME" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
    code=$?
    ms=$(_time_end)
    print_run_result "$code" "$ms"
    CLASS_FILE="${DIR}/${NAME}.class"
    if [[ -f "$CLASS_FILE" ]]; then
      if [[ "$KEEP_BIN" == true ]]; then
        info "Class file kept (--keep): ${BOLD}${CLASS_FILE}${RESET}"
        echo ""
      else
        read -rp "$(echo -e "  ${YELLOW}Delete compiled '${BOLD}${NAME}.class${RESET}${YELLOW}'? [Y/n]${RESET} ")" ans
        echo ""
        case "$ans" in
          n|N|no|NO) info "Class file kept: ${BOLD}${CLASS_FILE}${RESET}" ;;
          *)          rm -f "$CLASS_FILE"; success "Class file deleted." ;;
        esac
        echo ""
      fi
    fi
    exit "$code"
    ;;

  rs)
    compiled_run rustc
    ;;

  go)   interpreted_run go run ;;
  py)   interpreted_run python3 ;;
  js)   interpreted_run node ;;
  ts)   interpreted_run ts-node ;;
  sh)   interpreted_run bash ;;
  rb)   interpreted_run ruby ;;
  php)  interpreted_run php ;;

  *)
    error "Unsupported extension '.${EXT}'\nRun ${BOLD}cr --help${RESET} to see all supported languages."
    ;;
esac