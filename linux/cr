#  Printing run result
print_run_result() {
  local code="$1" ms="$2"
  echo -e "  ${DIM}─────────────────────────────────${RESET}"
  if [[ "$code" -eq 0 ]]; then
    success "${BOLD}Run successful${RESET}  ${DIM}│  exit code ${BOLD}0${RESET}${DIM}  │  ${ms}ms${RESET}  ✓"
  else
    warn "${BOLD}Run finished with errors${RESET}  ${DIM}│  exit code ${BOLD}${code}${RESET}${DIM}  │  ${ms}ms${RESET}"
  fi
  echo ""
}

#  Ask to delete the binary

maybe_delete() {
  local bin="$1"
  [[ -f "$bin" ]] || return
  if [[ "$KEEP_BIN" == true ]]; then
    info "Binary kept (--keep flag): ${BOLD}${bin}${RESET}"
    echo ""
    return
  fi
  read -rp "$(echo -e "  ${YELLOW}Delete compiled binary '${BOLD}$(basename "$bin")${RESET}${YELLOW}'? [Y/n]${RESET} ")" ans
  echo ""
  case "$ans" in
    n|N|no|NO)
      info "Binary kept: ${BOLD}${bin}${RESET}"
      ;;
    *)
      rm -f "$bin"
      success "Binary deleted."
      ;;
  esac
  echo ""
}

#  Compiled language runner
compiled_run() {
  local compiler="$1"; shift   # remaining args = compile flags (no -o, no FILE)
  need "$compiler"

  step "Compiling with ${BOLD}${compiler}${RESET}…"
  _time_start
  if "$compiler" "$@" -o "$OUTBIN" "$FILE"; then
    local ms; ms=$(_time_end)
    success "${BOLD}Compile successful${RESET}  ${DIM}│  ${ms}ms${RESET}"
  else
    echo ""
    error "Compilation failed. Fix the errors above and retry."
  fi

  echo ""
  step "Running ${BOLD}$(basename "$OUTBIN")${RESET}…"
  echo -e "  ${DIM}─────────────────────────────────${RESET}"
  _time_start
  "$OUTBIN" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
  local code=$?
  local ms; ms=$(_time_end)
  print_run_result "$code" "$ms"
  maybe_delete "$OUTBIN"
  exit "$code"
}

#  Benchmark for compiled languages (C/C++/Rust)
compiled_bench() {
  local compiler="$1"; shift
  need "$compiler"
  # Compile timing
  _time_start
  if "$compiler" "$@" -o "$OUTBIN" "$FILE"; then
    local c_ms; c_ms=$(_time_end)
  else
    error "Compilation failed. Fix the errors above and retry."
  fi

  # Runtime timing and memory via time command
  local time_cmd=""; local has_v=false
  if command -v /usr/bin/time >/dev/null 2>&1; then
    time_cmd="/usr/bin/time"
  elif command -v /bin/time >/dev/null 2>&1; then
    time_cmd="/bin/time"
  elif command -v time >/dev/null 2>&1; then
    time_cmd="time"
  fi

  local r_sec=0 mem_kb=""
  if [[ -n "$time_cmd" ]]; then
    # Try verbose first to parse "Maximum resident set size"
    local tmp_out tmp_err
    tmp_out=$(mktemp) ; tmp_err=$(mktemp)
    _time_start
    "$time_cmd" -v "$OUTBIN" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}" >"$tmp_out" 2>"$tmp_err"
    local run_code=$?
    local r_ms; r_ms=$(_time_end)
    r_sec=$(awk -v ms="$r_ms" 'BEGIN{printf "%.2f", ms/1000.0}')
    if grep -q "Maximum resident set size" "$tmp_err" 2>/dev/null; then
      mem_kb=$(grep -m1 "Maximum resident set size" "$tmp_err" | awk '{print $6}')
    else
      # Fallback to format output in KB
      : >"$tmp_err"
      _time_start
      "$time_cmd" -f "%M" "$OUTBIN" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}" >"$tmp_out" 2>"$tmp_err"
      run_code=$?
      r_ms=$(_time_end)
      r_sec=$(awk -v ms="$r_ms" 'BEGIN{printf "%.2f", ms/1000.0}')
      mem_kb=$(cat "$tmp_err" | tail -n1)
    fi
    rm -f "$tmp_out" "$tmp_err"
    # Do not prompt on bench; delete unless kept
    if [[ "$KEEP_BIN" != true ]]; then rm -f "$OUTBIN"; fi
  else
    # No time utility: measure time only, no memory
    _time_start
    "$OUTBIN" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
    local run_code=$?
    local r_ms; r_ms=$(_time_end)
    r_sec=$(awk -v ms="$r_ms" 'BEGIN{printf "%.2f", ms/1000.0}')
    if [[ "$KEEP_BIN" != true ]]; then rm -f "$OUTBIN"; fi
  fi

  # Print results
  local c_sec; c_sec=$(awk -v ms="$c_ms" 'BEGIN{printf "%.2f", ms/1000.0}')
  echo "Compile time: ${c_sec}s"
  echo "Runtime: ${r_sec}s"
  if [[ -n "$mem_kb" && "$mem_kb" =~ ^[0-9]+$ ]]; then
    local mem_mb; mem_mb=$(awk -v k="$mem_kb" 'BEGIN{printf "%.0f", k/1024.0}')
    if [[ "$mem_mb" -lt 1 ]]; then
      echo "Memory usage: ${mem_kb}KB"
    else
      echo "Memory usage: ${mem_mb}MB"
    fi
  fi
  exit ${run_code:-0}
}

#  Interpreted language runner

interpreted_run() {
  local runtime="$1"; shift    # remaining args = runtime flags before FILE
  need "$runtime"

  step "Running with ${BOLD}${runtime}${RESET}…"
  echo -e "  ${DIM}─────────────────────────────────${RESET}"
  _time_start
  "$runtime" "$@" "$FILE" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
  local code=$?
  local ms; ms=$(_time_end)
  print_run_result "$code" "$ms"
  exit "$code"
}

